# Copy to .env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# Leave unset to use the local SQLite fallback (backend/dev.sqlite3).
# For PostgreSQL:
# DATABASE_URL=postgres://brahmamudi:brahmamudi@localhost:5432/brahmamudi

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Google Sign-In — OAuth 2.0 Client ID (Web application) from Google Cloud Console.
# Leave blank to disable the "Continue with Google" buttons.
GOOGLE_OAUTH_CLIENT_ID=

# PayU
PAYU_ENVIRONMENT=staging

# Email (defaults to console backend in dev)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@brahmamudi.com

# Used to build links in verification / password-reset emails
FRONTEND_BASE_URL=http://localhost:3000
