# Copy to .env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
# LOG_JSON=true          # structured JSON logs (default: on when DEBUG is off)

# Error tracking — leave SENTRY_DSN blank to disable.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=

# Leave unset to use the local SQLite fallback (backend/dev.sqlite3).
# For PostgreSQL:
# DATABASE_URL=postgres://brahmamudi:brahmamudi@localhost:5432/brahmamudi

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Google Sign-In — OAuth 2.0 Client ID (Web application) from Google Cloud Console.
# Leave blank to disable the "Continue with Google" buttons.
GOOGLE_OAUTH_CLIENT_ID=

# PayU
PAYU_ENVIRONMENT=staging

# Cache — leave unset for local-memory cache. In production point at a shared
# store so rate limits hold across processes, e.g.:
# CACHE_URL=redis://localhost:6379/1

# Email — defaults to the console backend in dev. For real delivery:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@brahmamudi.com

# Used to build links in verification / password-reset emails
FRONTEND_BASE_URL=http://localhost:3000
# Public URL of this API (payment-gateway return URLs)
BACKEND_BASE_URL=http://localhost:8000

# API rate limits (DRF throttling). Uses the default cache; set a shared cache
# (e.g. Redis via CACHE_URL) in production so limits hold across processes.
# THROTTLE_ANON=60/min
# THROTTLE_USER=240/min
# THROTTLE_AUTH=20/min
# THROTTLE_PASSWORD_RESET=5/hour
# THROTTLE_INTEREST_CREATE=40/hour
# THROTTLE_CONTACT_UNLOCK=60/hour
# THROTTLE_PORUTHAM=120/hour
# THROTTLE_PHOTO_UPLOAD=30/hour
