# Copy to .env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
# LOG_JSON=true          # structured JSON logs (default: on when DEBUG is off)

# Error tracking — leave SENTRY_DSN blank to disable.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=

# Leave unset to use the local SQLite fallback (backend/dev.sqlite3).
# For PostgreSQL:
# DATABASE_URL=postgres://brahmamudi:brahmamudi@localhost:5432/brahmamudi

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Google Sign-In — OAuth 2.0 Client ID (Web application) from Google Cloud Console.
# Leave blank to disable the "Continue with Google" buttons.
GOOGLE_OAUTH_CLIENT_ID=

# Django admin (superuser-only). Use a non-obvious path in production.
# DJANGO_ADMIN_PATH=admin/
# ADMIN_LOGIN_MAX_ATTEMPTS=8
# ADMIN_LOGIN_LOCKOUT_SECONDS=900

# REQUIRE_EMAIL_VERIFICATION=true   # gate write actions on a confirmed email
# PROFILE_PHOTO_MAX_SIDE=1600       # longest edge photos are downscaled to
# PROFILE_PHOTO_QUALITY=85
# PROFILE_PHOTO_MAX_BYTES=900000    # re-encode JPEGs larger than this

# PayU
PAYU_ENVIRONMENT=staging

# Cache — leave unset for local-memory cache. In production point at a shared
# store so rate limits hold across processes, e.g.:
# CACHE_URL=redis://localhost:6379/1

# Email — defaults to the console backend in dev (prints instead of sending).
# Railway (and most PaaS hosts) block outbound SMTP entirely, so real delivery
# goes through Resend's HTTP API instead of SMTP. Set this to switch:
# RESEND_API_KEY=re_...
# DEFAULT_FROM_EMAIL must be on a domain verified in Resend, or the sandbox
# address onboarding@resend.dev while testing without a verified domain.
DEFAULT_FROM_EMAIL=no-reply@brahmamudi.com

# Emailed 6-digit codes for signup verification + password reset
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# Used to build links in emails (digest unsubscribe, legacy verify links)
FRONTEND_BASE_URL=http://localhost:3000
# Public URL of this API (payment-gateway return URLs)
BACKEND_BASE_URL=http://localhost:8000

# API rate limits (DRF throttling). Uses the default cache; set a shared cache
# (e.g. Redis via CACHE_URL) in production so limits hold across processes.
# THROTTLE_ANON=60/min
# THROTTLE_USER=240/min
# THROTTLE_AUTH=20/min
# THROTTLE_PASSWORD_RESET=5/hour
# THROTTLE_INTEREST_CREATE=40/hour
# THROTTLE_CONTACT_UNLOCK=60/hour
# THROTTLE_PORUTHAM=120/hour
# THROTTLE_PHOTO_UPLOAD=30/hour
